# 개발용 Discord Developer Portal의 Bot 토큰
DISCORD_TOKEN=replace-with-your-development-bot-token

# 개발용 Discord Developer Portal의 Application ID
DISCORD_CLIENT_ID=replace-with-your-development-application-id

# 개발용 Discord 서버 ID
DISCORD_GUILD_ID=replace-with-your-development-guild-id

# 개발용 봇에는 /테스트와 테스트 전용 Wordle 서브커맨드를 등록합니다.
ENABLE_TEST_COMMANDS=true

# 개발용 사용자별 Wordle 진행 사항을 저장할 SQLite 파일 경로
WORDLE_DATABASE_PATH=data/wordle.development.sqlite
