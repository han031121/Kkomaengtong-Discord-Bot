# Discord Developer Portal의 Bot 토큰
DISCORD_TOKEN=replace-with-your-bot-token

# Discord Developer Portal의 Application ID
DISCORD_CLIENT_ID=replace-with-your-application-id

# 선택 사항: 개발 서버 ID를 지정하면 명령어가 해당 서버에 즉시 등록됩니다.
# 비워 두면 전역 명령어로 등록되며 반영까지 시간이 걸릴 수 있습니다.
DISCORD_GUILD_ID=

# 메인 봇에서는 테스트 전용 Wordle 서브커맨드를 등록하지 않습니다.
ENABLE_TEST_COMMANDS=false

# 선택 사항: 사용자별 Wordle 진행 사항을 저장할 SQLite 파일 경로
WORDLE_DATABASE_PATH=data/wordle.sqlite
